{
  "name": "partyverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PARTYVERSE - jogo multiplayer cooperativo 3D (Three.js + Node.js autoritativo)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && node scripts/build-server.mjs",
    "start": "node --no-warnings dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.4.0"
  }
}
