# PH Cloud — variáveis de ambiente. Copie para .env.local (desenvolvimento) ou configure na hospedagem.
# NUNCA coloque valores reais neste arquivo: ele vai para o repositório.

# URL pública do site (sem barra no final). Usada em links do Stripe, cookies seguros e verificação de origem.
APP_URL=http://localhost:3000

# Segredo para assinar tokens (mínimo de 32 caracteres). Obrigatório em produção.
# Gere com: openssl rand -base64 48
APP_SECRET=

# Banco de dados PostgreSQL (Neon, Supabase, Railway, servidor próprio…).
# Vazio = banco embutido PGlite em PGLITE_DATA_DIR (bom para desenvolvimento ou um único servidor;
# não use em hospedagem serverless, onde o disco não persiste).
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Migrações automáticas ao iniciar (true por padrão). Use "false" e rode `npm run db:migrate` no deploy, se preferir.
DB_AUTO_MIGRATE=true

# E-mails (separados por vírgula) que viram administradores ao entrar/cadastrar.
ADMIN_EMAILS=
# E-mail exibido na Central de ajuda (recuperação de senha, suporte).
SUPPORT_EMAIL=

# Pagamentos — Stripe (https://dashboard.stripe.com/apikeys). Sem estas variáveis, as assinaturas ficam desativadas.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook apontado para {APP_URL}/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes mensais em BRL (price_…), criados no painel do Stripe.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=

# Provedores de jogos incorporados (exigem permissão/termos de cada provedor; veja docs/PROVEDORES.md).
PROVIDER_ITCHIO_ENABLED=false
PROVIDER_GAMEDISTRIBUTION_ENABLED=false

# Origem separada para servir os jogos próprios (opcional, ex.: https://jogos.seudominio.com.br).
GAMES_ORIGIN=

# Estação de streaming própria (servidor com GPU rodando Selkies, Neko ou similar). Vazio = não configurada.
CLOUD_STREAM_URL=
CLOUD_STREAM_HEALTH_URL=
# selkies | neko | generic
CLOUD_STREAM_KIND=generic
CLOUD_STREAM_NAME=Estação PH Cloud
# true se o backend aceita microfone (o iframe recebe permissão de microfone)
CLOUD_STREAM_MIC=false
